<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/buttonDelete"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewGlucoseValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120 mg/dL"
                android:textColor="@color/primary_green"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:text="2023-10-27 10:00"
                android:textSize="12sp"
                android:textColor="@color/app_text" />

            <TextView
                android:id="@+id/textViewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Status: Normal"
                android:textColor="@color/dark_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes: Feeling good"
                android:textColor="@color/app_text" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/light_gray" />

            <TextView
                android:id="@+id/textViewAiTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Tip: Drink more water"
                android:textColor="@color/dark_green"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/textViewActivitySuggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggestion: Go for a walk"
                android:textColor="@color/primary_green" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Reading"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/dark_green" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>